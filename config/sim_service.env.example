# Simulation service environment configuration
# Generated from scripts/env/generate_sim_env.py

SIM_APP_NAME="Simulation Service"
SIM_APP_VERSION="0.1.0"
SIM_APP_DEBUG=false
SIM_DOCS_URL="/docs"
SIM_REDOC_URL="/docs"
SIM_OPENAPI_URL="/openapi.json"

SIM_REQUEST_ID_HEADER="X-Request-ID"
SIM_DEFAULT_TIMEOUT_MS=80
SIM_DEFAULT_MC_PATHS=5000
SIM_DRY_RUN_DEFAULT=true

SIM_SERVICE_REGISTRY_ENABLED=true
SIM_SERVICE_REGISTRY_NAME="simulation"
