SIM_SERVICE_REGISTRY_HEARTBEAT=30.0
SIM_SERVICE_REGISTRY_REGISTRATION_ATTEMPTS=10
SIM_SERVICE_REGISTRY_RESTART_MODE=""
SIM_SERVICE_REGISTRY_DOCKER_CONTAINER=""
SIM_SERVICE_REGISTRY_DOCKER_HOST=""

LOG_DIR=logs
LOG_LEVEL=INFO
LOG_STREAM=true

DATA_DIR=data
REDIS_URL=redis://127.0.0.1:6379/0
