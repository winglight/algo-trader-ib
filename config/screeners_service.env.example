# Local Screeners service. Keep the preview disabled unless it is explicitly enabled.
SCREENERS_ADMIN_PREVIEW_ENABLED=false
# Required when the admin preview is enabled. The backend Gateway and Screeners
# service both read this single configuration source.
SCREENERS_GATEWAY_SHARED_SECRET=""

SCREENERS_APP_NAME="Screeners Service"
SCREENERS_APP_VERSION="0.1.0"
SCREENERS_APP_DEBUG=false
SCREENERS_DOCS_URL=""
SCREENERS_REDOC_URL=""
SCREENERS_OPENAPI_URL=""
SCREENERS_REQUEST_ID_HEADER="X-Request-ID"
SCREENERS_HOST=0.0.0.0
SCREENERS_PORT=8116

SCREENERS_DATABASE_REQUIRED=true
SCREENERS_REDIS_REQUIRED=true
SCREENERS_REDIS_URL=""

SCREENERS_SERVICE_REGISTRY_ENABLED=true
SCREENERS_SERVICE_REGISTRY_NAME="screeners"
SCREENERS_SERVICE_REGISTRY_SCHEME="http"
SCREENERS_SERVICE_REGISTRY_HOST="screeners-service"
SCREENERS_SERVICE_REGISTRY_PORT=8116
SCREENERS_SERVICE_REGISTRY_URL=""
SCREENERS_SERVICE_REGISTRY_KEY="services:registry"
SCREENERS_SERVICE_REGISTRY_HEARTBEAT=30.0
SCREENERS_SERVICE_REGISTRY_REGISTRATION_ATTEMPTS=10
SCREENERS_SERVICE_REGISTRY_RESTART_MODE="docker"
SCREENERS_SERVICE_REGISTRY_DOCKER_CONTAINER="algo-trader-screeners"
SCREENERS_SERVICE_REGISTRY_DOCKER_HOST="unix:///var/run/docker.sock"

SCREENERS_SERVICE_DISCOVERY_ENABLED=true
SCREENERS_BROKER_RUNNER_SERVICE_NAME="broker-runner"
SCREENERS_BROKER_RUNNER_SERVICE_URL="http://broker-runner-service:8115"
SCREENERS_STRATEGY_SPEC_SERVICE_NAME="strategy-spec"
SCREENERS_STRATEGY_SPEC_SERVICE_URL="http://strategy-spec-service:8114"
SCREENERS_DEPENDENCY_TIMEOUT_SECONDS=75.0

SCREENERS_RETENTION_DAYS=7
SCREENERS_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
SCREENERS_RETENTION_CLEANUP_ENABLED=true
SCREENERS_CATALOG_SYNC_ENABLED=true
SCREENERS_CATALOG_SYNC_TIMEZONE="America/New_York"
SCREENERS_CATALOG_SYNC_HOUR=3
SCREENERS_CATALOG_SYNC_MINUTE=15
SCREENERS_CATALOG_LOCK_KEY="screeners:catalog:sync:ib"
SCREENERS_CATALOG_LOCK_TTL_SECONDS=300
SCREENERS_CATALOG_MAX_XML_BYTES=4194304
SCREENERS_CATALOG_MIN_COUNT_RATIO=0.5
SCREENERS_CATALOG_STALE_AFTER_HOURS=48
SCREENERS_CATALOG_RETRY_ATTEMPTS=3
SCREENERS_CATALOG_RETRY_DELAY_SECONDS=1

SCREENERS_PREVIEW_STAGE_TIMEOUT_SECONDS=30
SCREENERS_PREVIEW_FIELD_TIMEOUT_SECONDS=60
SCREENERS_PREVIEW_SYMBOL_CONCURRENCY=4
SCREENERS_RUNTIME_ENABLED=true
SCREENERS_RUNTIME_MAX_ACTIVE_DEFINITIONS=3
SCREENERS_RUNTIME_HISTORY_CONCURRENCY=4
SCREENERS_RUNTIME_CANDIDATE_CONCURRENCY=8
SCREENERS_RUNTIME_DETACH_DELAY_SECONDS=5
SCREENERS_RUNTIME_SESSION_CHECK_INTERVAL_SECONDS=15
SCREENERS_RUNTIME_HEARTBEAT_INTERVAL_SECONDS=10
SCREENERS_RUNTIME_ADAPTER_CHECK_INTERVAL_SECONDS=30
SCREENERS_RUNTIME_RECONNECT_INITIAL_SECONDS=1
SCREENERS_RUNTIME_RECONNECT_MAX_SECONDS=30
SCREENERS_RUNTIME_TRACE_PAYLOAD_BYTES=16384
