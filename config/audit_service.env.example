# Public Audit service defaults. Runtime connection values are supplied by
# docker-compose.yml so credentials remain in the permission-controlled .env.
AUDIT_APP_NAME="Audit Service"
AUDIT_APP_VERSION="0.1.0"
AUDIT_DOCS_URL=""
AUDIT_REDOC_URL=""
AUDIT_OPENAPI_URL=""
AUDIT_API_PREFIX=""
AUDIT_EVENTS_RETENTION_LIMIT=200000
AUDIT_MAX_INGEST_BATCH=1000
AUDIT_AI_REPORT_MAX_EVENTS=5000
AUDIT_COLLECTOR_TIMEOUT_SECONDS=2.0
AUDIT_API_TIMEOUT_SECONDS=2.0
AUDIT_API_AUTH_TOKEN=""
AUDIT_LLM_API_TIMEOUT_SECONDS=120.0
AUDIT_SERVICE_REGISTRY_ENABLED=true
AUDIT_SERVICE_REGISTRY_NAME="audit"
AUDIT_SERVICE_REGISTRY_SCHEME="http"
AUDIT_SERVICE_REGISTRY_HOST="audit-service"
AUDIT_SERVICE_REGISTRY_PORT=8109
AUDIT_SERVICE_REGISTRY_URL=""
AUDIT_SERVICE_REGISTRY_KEY="services:registry"
AUDIT_SERVICE_REGISTRY_HEARTBEAT=30.0
AUDIT_SERVICE_REGISTRY_REGISTRATION_ATTEMPTS=10
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_STREAM=true
AUDIT_COLLECTOR_TOKEN=""
