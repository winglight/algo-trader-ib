# Public runtime watchdog profile.
API_SERVICE_URL=http://backend:8000
STRATEGY_SERVICE_URL=http://strategy-service:8104

SERVICE_WATCHDOG_SERVICES=api|http://backend:8000/healthz|||restart_mode=docker,docker_container=algo-trader-backend,docker_host=unix:///var/run/docker.sock;broker-runner|http://broker-runner-service:8115/healthz|||restart_mode=docker,docker_container=algo-trader-broker-runner,docker_host=unix:///var/run/docker.sock;account|http://account-service:8100/healthz|||restart_mode=docker,docker_container=algo-trader-account,docker_host=unix:///var/run/docker.sock;orders|http://orders-service:8101/healthz|||restart_mode=docker,docker_container=algo-trader-orders,docker_host=unix:///var/run/docker.sock;market-data|http://market-data-service:8102/healthz|||restart_mode=docker,docker_container=algo-trader-market-data,docker_host=unix:///var/run/docker.sock;risk|http://risk-service:8103/healthz|||restart_mode=docker,docker_container=algo-trader-risk,docker_host=unix:///var/run/docker.sock;strategy|http://strategy-service:8104/healthz|||restart_mode=docker,docker_container=algo-trader-strategy,docker_host=unix:///var/run/docker.sock;simulation|http://simulation-service:8111/healthz|||restart_mode=docker,docker_container=algo-trader-sim,docker_host=unix:///var/run/docker.sock;strategy-spec|http://strategy-spec-service:8114/healthz|||restart_mode=docker,docker_container=algo-trader-strategy-spec,docker_host=unix:///var/run/docker.sock;screeners|http://screeners-service:8116/healthz|||restart_mode=docker,docker_container=algo-trader-screeners,docker_host=unix:///var/run/docker.sock;frontend|http://frontend/|||restart_mode=docker,docker_container=algo-trader-frontend,docker_host=unix:///var/run/docker.sock

SERVICE_WATCHDOG_INTERVAL=20
SERVICE_WATCHDOG_STARTUP_DELAY=20
SERVICE_WATCHDOG_STARTUP_MAX_WAIT=300
SERVICE_WATCHDOG_TIMEOUT=5
SERVICE_WATCHDOG_MAX_FAILURES=6
SERVICE_WATCHDOG_RESTART_TIMEOUT=45
SERVICE_WATCHDOG_RESTART_COOLDOWN=600
SERVICE_WATCHDOG_MIN_UPTIME_BEFORE_RESTART=900
SERVICE_WATCHDOG_MIN_UNHEALTHY_DURATION=600
SERVICE_WATCHDOG_STRATEGY_STREAM_ENABLED=0
SERVICE_WATCHDOG_COLLECTOR_ENABLED=1
SERVICE_WATCHDOG_COLLECTOR_HOST=0.0.0.0
SERVICE_WATCHDOG_COLLECTOR_PORT=8110
SERVICE_WATCHDOG_IB_GATEWAY_ENABLED=0
SERVICE_WATCHDOG_IB_GATEWAY_CONTAINER=ib-gateway
SERVICE_WATCHDOG_IB_GATEWAY_DOCKER_HOST=unix:///var/run/docker.sock
SERVICE_WATCHDOG_IB_GATEWAY_READINESS_HOST=ib-gateway
SERVICE_WATCHDOG_IB_GATEWAY_VNC_PORT=5900
SERVICE_WATCHDOG_IB_GATEWAY_API_PORT=4004
SERVICE_WATCHDOG_IB_GATEWAY_READINESS_TIMEOUT_SECONDS=120
SERVICE_WATCHDOG_IB_GATEWAY_READINESS_INTERVAL_SECONDS=5
SERVICE_WATCHDOG_IB_GATEWAY_READINESS_PROBE_TIMEOUT_SECONDS=5
SERVICE_WATCHDOG_IB_GATEWAY_READINESS_STABLE_SUCCESSES=3
SERVICE_WATCHDOG_IB_GATEWAY_RESTART_ATTEMPTS=2
SERVICE_WATCHDOG_SCHEDULED_JOBS=[]
