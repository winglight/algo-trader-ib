# Risk service environment configuration
# Generated from scripts/env/generate_risk_env.py
#
# Copy this file to `.env.risk` (或类似路径) 并根据部署环境调整变量。
# 服务会读取这些变量构建 FastAPI 与风险引擎参数。

# FastAPI metadata
RISK_APP_NAME="Risk Service"
RISK_APP_VERSION="0.1.0"
RISK_APP_DEBUG=false

# Request correlation
RISK_REQUEST_ID_HEADER="X-Request-ID"

# CORS configuration
RISK_CORS_ENABLED=false
RISK_CORS_ALLOW_ORIGINS=*
RISK_CORS_ALLOW_METHODS=*
RISK_CORS_ALLOW_HEADERS=*

# Redis publish/subscribe channels
RISK_ALERTS_CHANNEL="risk.alert"
RISK_METRICS_CHANNEL="risk.metric"
RISK_PUBLISH_METRICS=true
RISK_EVENT_HISTORY_LIMIT=200
RISK_PERFORMANCE_METRICS="unrealized_pnl,realized_pnl"

# Market data retry behaviour
RISK_MARKET_DATA_RETRY_INTERVAL=5.0
RISK_MARKET_DATA_BASE_URL="http://market-data-service:8102"

# Risk resolves the owning Strategy SPEC from filled orders before applying an
# asset-level exit rule.  This endpoint must remain available during recovery.
RISK_ORDERS_BASE_URL="http://orders-service:8101"

# Risk engine tuning
RISK_TRAILING_COOLDOWN=5.0
RISK_DEFAULT_REDUCE_FRACTION=1.0
RISK_POSITION_EPSILON=0.0001
RISK_EXIT_POSITION_EPSILON=0.0001
RISK_VIOLATION_EVENT_LEVEL="critical"
RISK_WARNING_EVENT_LEVEL="warning"
RISK_INFO_EVENT_LEVEL="info"

# Service discovery registration
RISK_SERVICE_REGISTRY_ENABLED=true
RISK_SERVICE_REGISTRY_NAME="risk"
RISK_SERVICE_REGISTRY_SCHEME="http"
RISK_SERVICE_REGISTRY_HOST=risk-service
RISK_SERVICE_REGISTRY_PORT=8103
RISK_SERVICE_REGISTRY_URL=""
RISK_SERVICE_REGISTRY_KEY="services:registry"
RISK_SERVICE_REGISTRY_HEARTBEAT=30.0
RISK_SERVICE_REGISTRY_REGISTRATION_ATTEMPTS=10
RISK_SERVICE_REGISTRY_RESTART_MODE=""
RISK_SERVICE_REGISTRY_DOCKER_CONTAINER=""
RISK_SERVICE_REGISTRY_DOCKER_HOST=""

# Simulation integration (Phase 1 dry-run)
RISK_SIM_SERVICE_NAME="simulation"
RISK_SIM_BASE_URL="http://simulation-service:8111"
RISK_SIM_TIMEOUT=5.0
SIM_SERVICE_ENABLED=false
SIM_SERVICE_DRY_RUN=true

# Order Runner exit-protection rollout

# Logging configuration
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_STREAM=true

# Shared directories
DATA_DIR=data

# Shared Redis connection
REDIS_URL=redis://redis:6379/0

# MariaDB connection (inherits values from the root `.env`)
MARIADB_URL=mariadb://app_user:change_me@mariadb:3306/algo_trader
MARIADB_POOL_SIZE=5
MARIADB_MAX_OVERFLOW=10
MARIADB_POOL_RECYCLE=1800
MARIADB_ECHO=false
RISK_EXIT_ORDER_GUARD_SECONDS=30
RISK_EXIT_ORDER_GUARD_STALE_SECONDS=300
RISK_SPEC_TAKE_PROFIT_ORDER_MIN_INTERVAL_SECONDS=15
RISK_SPEC_TAKE_PROFIT_ORDER_MIN_DELTA=0.25
RISK_PRICE_TICKER_STALE_SECONDS=60
RISK_PRICE_ACCOUNT_STALE_SECONDS=60
RISK_POSITION_SNAPSHOT_STALE_SECONDS=120
RISK_POSITION_SNAPSHOT_RECOVERY_COOLDOWN_SECONDS=15
RISK_POSITION_SNAPSHOT_RESTART_COOLDOWN_SECONDS=300
RISK_POSITION_SNAPSHOT_RESTART_URL="http://service-watchdog:8110/watchdog/actions/services/risk/restart"
RISK_DISABLED_SYMBOLS=IBKR
