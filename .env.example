# Core application settings
APP_ENV=prod
APP_NAME="Algo Trader Backend"
APP_VERSION=0.1.0
APP_DEBUG=false
APP_CORS_ENABLED=true
APP_CORS_ALLOW_ORIGINS=*
APP_CORS_ALLOW_METHODS=*
APP_CORS_ALLOW_HEADERS=*
#APP_MANAGED_SERVICES=api|http://backend:8000/healthz|./scripts/run/backend.sh restart api||restart_mode=command;account|http://account-service:8100/healthz|./scripts/run/backend.sh restart account||restart_mode=command;orders|http://orders-service:8101/healthz|./scripts/run/backend.sh restart orders||restart_mode=command;market-data|http://market-data-service:8102/healthz|./scripts/run/backend.sh restart market-data||restart_mode=command;risk|http://risk-service:8103/healthz|./scripts/run/backend.sh restart risk||restart_mode=command;strategy|http://strategy-service:8104/healthz|./scripts/run/backend.sh restart strategy||restart_mode=command
BACKEND_WATCHDOG_ENABLED=1
STRATEGY_WATCHDOG_ENABLED=1
SERVICE_WATCHDOG_ENABLED=1
SERVICE_WATCHDOG_URL=http://service-watchdog:8110
SERVICE_RESTART_TIMEOUT=120
BACKEND_EXIT_RESTART_ENABLED=1
BACKEND_EXIT_RESTART_BASE_DELAY=2
BACKEND_EXIT_RESTART_MAX_DELAY=60
BACKEND_EXIT_RESTART_STABLE_WINDOW=90
BACKEND_EXIT_RESTART_ON_TERM=0
STRATEGY_CLIENT_AUTO_RESTART_ENABLED=0
STRATEGY_CLIENT_AUTO_RESTART_MIN_FAILURES=6
STRATEGY_CLIENT_AUTO_RESTART_MIN_UNAVAILABLE_SECONDS=180
STRATEGY_CLIENT_AUTO_RESTART_SUCCESS_COOLDOWN_SECONDS=300
LOG_LEVEL=WARNING
LOG_DIR=logs
LOG_STREAM=true
DATA_DIR=data

# Authentication
ALLOW_ANONYMOUS_ACCESS=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me
TOKEN_EXPIRE_MINUTES=60

MARKET_DATA_IB_HISTORICAL_TIMEOUT_SECONDS=180.0
MARKET_DATA_IB_HISTORICAL_CONCURRENCY=2

# Redis configuration
# Use ``rediss://`` to enable TLS-secured connections when required.
REDIS_URL=redis://:change_me@redis:6379/0
# Service discovery
SERVICE_DISCOVERY_ENABLED=true
SERVICE_DISCOVERY_REGISTRY_KEY=services:registry
# Retry policy when required services are missing during API bootstrap.
SERVICE_DISCOVERY_RETRY_INITIAL_DELAY=0.5
SERVICE_DISCOVERY_RETRY_MAX_DELAY=30.0
SERVICE_DISCOVERY_RETRY_MULTIPLIER=2.0
# 0 means retry forever until required services are discoverable.
SERVICE_DISCOVERY_REQUIRED_MAX_ATTEMPTS=0
# Retry policy for runtime endpoint lookup resolvers.
SERVICE_DISCOVERY_LOOKUP_ATTEMPTS=3
SERVICE_DISCOVERY_LOOKUP_INITIAL_DELAY=0.2
SERVICE_DISCOVERY_LOOKUP_MAX_DELAY=2.0
SERVICE_DISCOVERY_LOOKUP_MULTIPLIER=2.0
# Optional: external address for cross-host service discovery.
SERVICE_REMOTE_IP=
REMOTE_IP=
# Optional: advertise shared environment defaults via the service registry.
SERVICE_REGISTRY_SHARED_SETTINGS_NAME=
# SERVICE_REGISTRY_SHARED_SETTINGS_KEY=services:registry
# SERVICE_REGISTRY_SHARED_SETTINGS_TIMEOUT=2.0

# Backfill configuration
BACKFILL_QUEUE_NAME=backfill

# MariaDB configuration
MARIADB_URL=mariadb://app_user:change_me@mariadb:3306/algo_trader
MARIADB_POOL_SIZE=10
MARIADB_MAX_OVERFLOW=5
MARIADB_POOL_RECYCLE=1800
MARIADB_RETRY_ATTEMPTS=3
MARIADB_RETRY_BASE_DELAY=0.2

# Feature flags
ENABLE_NOTIFICATIONS=true
ENABLE_WEBSOCKET_PUSH=true

# ATI Cloud Gateway
ATI_CLOUD_SESSION_TOKEN=
ATI_CLOUD_SESSION_COOKIE_NAME=ati_cloud_session

# Downstream service integration
AUDIT_SERVICE_TIMEOUT=5.0
AUDIT_COLLECTOR_ENABLED=1
AUDIT_COLLECTOR_TIMEOUT_SECONDS=1.0
AUDIT_COLLECTOR_MAX_PENDING=1000
AUDIT_COLLECTOR_TOKEN=
SIM_SERVICE_TIMEOUT=5.0

# Strategy DOM guardrails (strategy service)
STRATEGY_INTENT_CHANNEL=strategy.intent
STRATEGY_AUDIT_CHANNEL=strategy.audit
STRATEGY_INTENT_TRADER_ROLES=trader,trader_admin,admin
STRATEGY_INTENT_ADMIN_ROLES=trader_admin,admin

# Queue defaults
QUEUE_VISIBILITY_TIMEOUT=30
QUEUE_MAX_ATTEMPTS=5
QUEUE_BASE_DELAY=0.5
QUEUE_BACKOFF_MULTIPLIER=2.0
QUEUE_MAX_DELAY=30

# Analytics
# Google Analytics 4 Measurement ID (Frontend)
# Google Analytics 4 Measurement ID (Backend Telemetry)
# Google Analytics 4 Measurement Protocol API Secret (Backend Telemetry)
