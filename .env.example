# Core application settings
APP_ENV=development
APP_NAME="Algo Trader Backend"
APP_VERSION=0.1.0
ATI_IMAGE_TAG=0.1.0
APP_DEBUG=false
APP_DOCS_URL=
APP_REDOC_URL=
APP_OPENAPI_URL=
APP_CORS_ENABLED=true
APP_CORS_ALLOW_ORIGINS=*
APP_CORS_ALLOW_METHODS=*
APP_CORS_ALLOW_HEADERS=*
APP_SERVICE_OPENAPI_ENDPOINTS=
APP_SERVICE_OPENAPI_AUTH_HEADER_NAME=
APP_SERVICE_OPENAPI_AUTH_HEADER_VALUE=
APP_MANAGED_SERVICES=api|http://backend:8000/healthz|||restart_mode=disabled;broker-runner|http://broker-runner-service:8115/healthz|||restart_mode=disabled;account|http://account-service:8100/healthz|||restart_mode=disabled;orders|http://orders-service:8101/healthz|||restart_mode=disabled;market-data|http://market-data-service:8102/healthz|||restart_mode=disabled;risk|http://risk-service:8103/healthz|||restart_mode=disabled;strategy|http://strategy-service:8104/healthz|||restart_mode=disabled;simulation|http://simulation-service:8111/healthz|||restart_mode=disabled;strategy-spec|http://strategy-spec-service:8114/healthz|||restart_mode=disabled
BACKEND_WATCHDOG_ENABLED=0
STRATEGY_WATCHDOG_ENABLED=0
SERVICE_WATCHDOG_ENABLED=0
SERVICE_WATCHDOG_STARTUP_DELAY=20
SERVICE_WATCHDOG_STARTUP_MAX_WAIT=300
SERVICE_WATCHDOG_INTERVAL=20
SERVICE_WATCHDOG_MAX_FAILURES=3
SERVICE_RESTART_TIMEOUT=120
BACKEND_EXIT_RESTART_ENABLED=1
BACKEND_EXIT_RESTART_BASE_DELAY=2
BACKEND_EXIT_RESTART_MAX_DELAY=60
BACKEND_EXIT_RESTART_STABLE_WINDOW=90
BACKEND_EXIT_RESTART_ON_TERM=0
LOG_LEVEL=WARNING
LOG_DIR=logs
LOG_STREAM=true
DATA_DIR=data

# Authentication
ADMIN_USERNAME=ati-guest
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me
TOKEN_EXPIRE_MINUTES=60

# Simulated broker adapter
BROKER_ADAPTER_MODE=sim
BROKER_RUNNER_ADAPTER_ENTRYPOINT=src.broker_adapters.sim:create_adapter
BROKER_RUNNER_URL=http://broker-runner-service:8115
ACCOUNT_BROKER_RUNNER_URL=http://broker-runner-service:8115
ORDERS_BROKER_RUNNER_URL=http://broker-runner-service:8115
MARKET_DATA_BROKER_RUNNER_URL=http://broker-runner-service:8115
BROKER_RUNNER_IB_GATEWAY_HOST=ib-gateway
BROKER_RUNNER_IB_GATEWAY_PORT=4004
BROKER_RUNNER_IB_CLIENT_ID=40
BROKER_RUNNER_IB_CLIENT_ID_FALLBACKS=
BROKER_RUNNER_IB_CONNECT_TIMEOUT=15.0
BROKER_RUNNER_IB_READ_ONLY=false
BROKER_RUNNER_IB_ACCOUNT=
BROKER_RUNNER_IB_MARKET_DATA_DEPTH_ROWS=10
BROKER_RUNNER_IB_MARKET_DATA_QUEUE_SIZE=64
BROKER_RUNNER_IB_HISTORICAL_TIMEOUT=300.0

# Redis configuration
# Use ``rediss://`` to enable TLS-secured connections when required.
REDIS_URL=redis://:change_me@redis:6379/0
# Service discovery
SERVICE_DISCOVERY_ENABLED=true
SERVICE_DISCOVERY_REGISTRY_KEY=services:registry
# Retry policy when required services are missing during API bootstrap.
SERVICE_DISCOVERY_RETRY_INITIAL_DELAY=0.5
SERVICE_DISCOVERY_RETRY_MAX_DELAY=30.0
SERVICE_DISCOVERY_RETRY_MULTIPLIER=2.0
# 0 means retry forever until required services are discoverable.
SERVICE_DISCOVERY_REQUIRED_MAX_ATTEMPTS=0
# Retry policy for runtime endpoint lookup resolvers.
SERVICE_DISCOVERY_LOOKUP_ATTEMPTS=3
SERVICE_DISCOVERY_LOOKUP_INITIAL_DELAY=0.2
SERVICE_DISCOVERY_LOOKUP_MAX_DELAY=2.0
SERVICE_DISCOVERY_LOOKUP_MULTIPLIER=2.0
# Optional: external address for cross-host service discovery.
SERVICE_REMOTE_IP=
REMOTE_IP=
# Optional: advertise shared environment defaults via the service registry.
SERVICE_REGISTRY_SHARED_SETTINGS_NAME=
# SERVICE_REGISTRY_SHARED_SETTINGS_KEY=services:registry
# SERVICE_REGISTRY_SHARED_SETTINGS_TIMEOUT=2.0

# Backfill configuration
BACKFILL_QUEUE_NAME=backfill

# MariaDB configuration
MARIADB_URL=mariadb://app_user:change_me@mariadb:3306/algo_trader
MARIADB_POOL_SIZE=10
MARIADB_MAX_OVERFLOW=5
MARIADB_POOL_RECYCLE=1800
MARIADB_RETRY_ATTEMPTS=3
MARIADB_RETRY_BASE_DELAY=0.2

# Feature flags
ENABLE_NOTIFICATIONS=true
ENABLE_WEBSOCKET_PUSH=true

# Risk management defaults
STOP_LOSS_RATIO=0.05
TAKE_PROFIT_RATIO=0.05
PRICE_THRESHOLD=0.02
ENABLE_TRAILING_SL_TP=true
LEVERAGE_INDEX_DEFAULT=20
LEVERAGE_INDEX_MICRO_DEFAULT=20
LEVERAGE_ES=20
LEVERAGE_MES=20
LEVERAGE_NQ=20
LEVERAGE_MNQ=20
LEVERAGE_YM=20
LEVERAGE_MYM=20
LEVERAGE_RTY=20
LEVERAGE_M2K=20
LEVERAGE_VX=10
CB_DAILY_R=3.0
CB_STREAK=3
RISK_PER_TRADE_R=0.005
RV_REF_VALUE=1.0
RV_REF_METHOD=static
VOL_WINDOW=20
DD_STEP=0.05
DD_MAX_STEPS=4
DD_SCALE=0.5
CONTRACT_ROUNDING=floor

# Queue defaults
QUEUE_VISIBILITY_TIMEOUT=30
QUEUE_MAX_ATTEMPTS=5
QUEUE_BASE_DELAY=0.5
QUEUE_BACKOFF_MULTIPLIER=2.0
QUEUE_MAX_DELAY=30

ALLOW_ANONYMOUS_ACCESS=false

# Analytics
# Google Analytics 4 Measurement ID (Frontend)
VITE_GA_MEASUREMENT_ID=
# Google Analytics 4 Measurement ID (Backend Telemetry)
GA_MEASUREMENT_ID=
# Google Analytics 4 Measurement Protocol API Secret (Backend Telemetry)
GA_API_SECRET=
